#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage:
  ./run CE                 Start all services and detect CE
  ./run replay FOLDER      Replay synchronized videos from FOLDER
  ./run list               List available CEs
  ./run logs               Follow detector logs
  ./run stop               Stop all services

Short names such as ce3 expand to iobt_ce3 when that file exists.
EOF
}

resolve_name() {
  local directory="$1"
  local requested="$2"
  if [[ -f "$directory/$requested.yaml" ]]; then
    printf '%s\n' "$requested"
  elif [[ -f "$directory/iobt_$requested.yaml" ]]; then
    printf '%s\n' "iobt_$requested"
  else
    echo "Unknown name '$requested'. Run './run list' to see available choices." >&2
    return 1
  fi
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

case "$1" in
  replay)
    [[ $# -eq 2 ]] || { usage; exit 2; }
    [[ -d "$2" ]] || { echo "Recording folder not found: $2" >&2; exit 1; }
    RECORDING_DIR="$(cd "$2" && pwd)"
    export RECORDING_DIR
    exec docker compose run --rm replay
    ;;
  list)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    echo "Complex events:"
    for path in ce_definitions/*.yaml; do basename "$path" .yaml; done
    ;;
  logs)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    exec docker compose logs -f detector
    ;;
  stop)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    exec docker compose down
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    ce_name="$(resolve_name ce_definitions "$1")"
    export CE_DEFINITION="$ce_name"
    exec docker compose up --build
    ;;
esac
